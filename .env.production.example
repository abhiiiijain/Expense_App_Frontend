# Copy to .env.production:
#   cp .env.production.example .env.production
#
# Used by `npm run build` (Vite production mode).

# Preview server port (optional for `vite preview`)
VITE_PORT=4043

# Backend origin only (no /api/v1 — that is added in code)
VITE_API_BASE_URL=https://expense-app-backend-srz0.onrender.com
